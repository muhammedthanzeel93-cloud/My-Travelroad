# ==============================================================================
# My Travelroad — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# Application Environment
NODE_ENV="development"

# PostgreSQL + PostGIS Connection URL
# Standard connection string for Prisma Client application queries.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mytravelroad?schema=public"

# Direct Database URL for Migrations (bypass connection poolers like PgBouncer)
# Required when using connection poolers that do not support prepared statements during migrations.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mytravelroad?schema=public"
