// ==============================================================================
// My Travelroad - Authoritative Prisma Schema (Stage A Database Foundation)
/// ==============================================================================
// Authoritative Architecture Reference: docs/architecture/database-architecture.md
// Domain Reference: docs/architecture/domain-model.md
//
// Stage A Tables Covered (15 total):
// 1. accounts
// 2. account_security_credentials
// 3. tourist_profiles
// 4. destination_categories
// 5. destinations
// 6. destination_locations
// 7. destination_media
// 8. destination_opening_hours
// 9. destination_verifications
// 10. verification_evidence
// 11. verification_records
// 12. saved_destinations
// 13. audit_logs
// 14. audit_log_telemetry
// 15. destination_secondary_categories (Junction)
/// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), postgis]
}

// ------------------------------------------------------------------------------
// 1. Identity & Credentials
// ------------------------------------------------------------------------------

model Account {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique(map: "uq_accounts_email") @db.VarChar(255)
  phone         String?   @unique(map: "uq_accounts_phone") @db.VarChar(32)
  emailVerified Boolean   @default(false) @map("email_verified")
  phoneVerified Boolean   @default(false) @map("phone_verified")
  status        String    @default("pending_verification") @db.VarChar(32)
  type          String    @default("individual") @db.VarChar(32)
  role          String    @default("traveler") @db.VarChar(32)
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 1:1 Isolated Security Credentials & Profile
  securityCredentials AccountSecurityCredential?
  touristProfile      TouristProfile?

  // Relations
  savedDestinations     SavedDestination[]
  assignedVerifications DestinationVerification[]
  submittedEvidence     VerificationEvidence[]
  certifiedRecords      VerificationRecord[]
  executedAuditLogs     AuditLog[]

  @@index([status], name: "idx_accounts_status")
  @@index([role], name: "idx_accounts_role")
  @@map("accounts")
}

model AccountSecurityCredential {
  accountId           String    @id @map("account_id") @db.Uuid
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEncrypted  String?   @map("mfa_secret_encrypted") @db.Text
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_security_account")

  @@map("account_security_credentials")
}

model TouristProfile {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId         String   @unique(map: "uq_profiles_account_id") @map("account_id") @db.Uuid
  displayName       String   @map("display_name") @db.VarChar(120)
  handle            String   @unique(map: "uq_profiles_handle") @db.VarChar(50)
  avatarUrl         String?  @map("avatar_url") @db.Text
  bio               String?  @db.Text
  homeRegion        String?  @map("home_region") @db.VarChar(120)
  preferredLanguage String   @default("en") @map("preferred_language") @db.VarChar(10)
  travelPreferences String[] @default([]) @map("travel_preferences")
  isPublic          Boolean  @default(true) @map("is_public")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_profiles_account")

  @@index([travelPreferences], type: Gin, name: "idx_profiles_travel_preferences")
  @@map("tourist_profiles")
}

// ------------------------------------------------------------------------------
// 2. Taxonomy & Categorization
// ------------------------------------------------------------------------------

model DestinationCategory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique(map: "uq_categories_slug") @db.VarChar(100)
  name         String   @db.VarChar(100)
  shortLabel   String   @map("short_label") @db.VarChar(50)
  description  String   @db.Text
  iconKey      String   @map("icon_key") @db.VarChar(50)
  parentId     String?  @map("parent_id") @db.Uuid
  displayOrder Int      @default(0) @map("display_order")
  status       String   @default("active") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   DestinationCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_categories_parent")
  children DestinationCategory[] @relation("CategoryHierarchy")

  primaryDestinations   Destination[]                  @relation("PrimaryCategory")
  secondaryDestinations DestinationSecondaryCategory[]

  @@index([parentId], name: "idx_categories_parent_id")
  @@index([status, displayOrder], name: "idx_categories_status_order")
  @@map("destination_categories")
}

// ------------------------------------------------------------------------------
// 3. Core Destinations & Spatial Entities
// ------------------------------------------------------------------------------

model Destination {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String    @unique(map: "uq_destinations_slug") @db.VarChar(120)
  title             String    @db.VarChar(200)
  shortDescription  String    @map("short_description") @db.VarChar(500)
  fullDescription   String    @map("full_description") @db.Text
  primaryCategoryId String    @map("primary_category_id") @db.Uuid
  publicationStatus String    @default("draft") @map("publication_status") @db.VarChar(32)
  featuredRank      Int?      @map("featured_rank")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)

  primaryCategory     DestinationCategory            @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_destinations_primary_category")
  secondaryCategories DestinationSecondaryCategory[]

  location            DestinationLocation?
  media               DestinationMedia[]
  openingHours        DestinationOpeningHour?
  verification        DestinationVerification?
  verificationRecords VerificationRecord[]
  savedBy             SavedDestination[]

  @@index([primaryCategoryId], name: "idx_destinations_primary_cat")
  @@index([publicationStatus], name: "idx_destinations_status")
  @@index([createdAt(sort: Desc)], name: "idx_destinations_created_at")
  @@map("destinations")
}

model DestinationSecondaryCategory {
  destinationId String   @map("destination_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  destination Destination         @relation(fields: [destinationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_sec_cat_destination")
  category    DestinationCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_sec_cat_category")

  @@id([destinationId, categoryId])
  @@index([categoryId], name: "idx_sec_cat_category")
  @@map("destination_secondary_categories")
}

model DestinationLocation {
  id                           String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  destinationId                String                                 @unique(map: "uq_locations_destination_id") @map("destination_id") @db.Uuid
  coordinates                  Unsupported("geography(Point, 4326)")
  altitudeMeters               Decimal?                               @map("altitude_meters") @db.Decimal(7, 2)
  accuracyMeters               Decimal?                               @map("accuracy_meters") @db.Decimal(6, 2)
  isRestricted                 Boolean                                @default(false) @map("is_restricted")
  restrictionReason            String?                                @map("restriction_reason") @db.VarChar(50)
  publicApproximateCentroid    Unsupported("geography(Point, 4326)")? @map("public_approximate_centroid")
  publicApproximateDisplayName String?                                @map("public_approximate_display_name") @db.VarChar(150)
  formattedAddress             String                                 @map("formatted_address") @db.Text
  locality                     String?                                @db.VarChar(120)
  talukOrSubdivision           String                                 @map("taluk_or_subdivision") @db.VarChar(100)
  district                     String                                 @db.VarChar(100)
  stateOrProvince              String                                 @map("state_or_province") @db.VarChar(100)
  countryCode                  String                                 @default("IN") @map("country_code") @db.Char(2)
  postalCode                   String?                                @map("postal_code") @db.VarChar(20)
  nearestTransitHub            Json?                                  @map("nearest_transit_hub") @db.JsonB
  createdAt                    DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime                               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_locations_destination")

  @@index([coordinates], type: Gist, name: "idx_locations_coordinates")
  @@index([district], name: "idx_locations_district")
  @@index([countryCode, stateOrProvince, district], name: "idx_locations_state_country")
  @@index([talukOrSubdivision], name: "idx_locations_taluk")
  @@index([isRestricted], name: "idx_locations_restricted")
  @@map("destination_locations")
}

model DestinationMedia {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  destinationId String   @map("destination_id") @db.Uuid
  type          String   @default("image") @db.VarChar(32)
  url           String   @db.Text
  thumbnailUrl  String?  @map("thumbnail_url") @db.Text
  altText       String   @map("alt_text") @db.VarChar(255)
  caption       String?  @db.Text
  attribution   String?  @db.VarChar(200)
  license       String   @default("cc_by") @db.VarChar(50)
  isCover       Boolean  @default(false) @map("is_cover")
  displayOrder  Int      @default(0) @map("display_order")
  status        String   @default("pending_review") @db.VarChar(32)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_media_destination")

  @@index([destinationId, displayOrder], name: "idx_media_destination_order")
  @@index([status], name: "idx_media_status")
  @@map("destination_media")
}

model DestinationOpeningHour {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  destinationId  String   @unique(map: "uq_opening_hours_destination") @map("destination_id") @db.Uuid
  type           String   @default("always_open") @db.VarChar(32)
  weeklySchedule Json?    @map("weekly_schedule") @db.JsonB
  seasonalNotes  String?  @map("seasonal_notes") @db.Text
  entryFeePolicy String   @default("free") @map("entry_fee_policy") @db.VarChar(32)
  feeStructure   Json?    @map("fee_structure") @db.JsonB
  advisoryNote   String?  @map("advisory_note") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_opening_hours_destination")

  @@index([entryFeePolicy], name: "idx_opening_hours_fee_policy")
  @@map("destination_opening_hours")
}

// ------------------------------------------------------------------------------
// 4. Governance, Verification & Documentary Proof
// ------------------------------------------------------------------------------

model DestinationVerification {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  destinationId     String    @unique(map: "uq_verifications_destination") @map("destination_id") @db.Uuid
  overallStatus     String    @default("unverified") @map("overall_status") @db.VarChar(32)
  assignedCuratorId String?   @map("assigned_curator_id") @db.Uuid
  lastAuditedAt     DateTime? @map("last_audited_at") @db.Timestamptz(6)
  nextAuditDueAt    DateTime? @map("next_audit_due_at") @db.Timestamptz(6)
  fieldStatuses     Json      @default("{}") @map("field_statuses") @db.JsonB
  curatorQueueNotes String?   @map("curator_queue_notes") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  destination     Destination            @relation(fields: [destinationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_verifications_destination")
  assignedCurator Account?               @relation(fields: [assignedCuratorId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_verifications_curator")
  evidence        VerificationEvidence[]
  records         VerificationRecord[]

  @@index([overallStatus], name: "idx_verifications_status")
  @@map("destination_verifications")
}

model VerificationEvidence {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  verificationId        String   @map("verification_id") @db.Uuid
  evidenceType          String   @map("evidence_type") @db.VarChar(50)
  documentUrl           String?  @map("document_url") @db.Text
  sourceOrganization    String   @map("source_organization") @db.VarChar(150)
  officialReferenceCode String?  @map("official_reference_code") @db.VarChar(100)
  notes                 String?  @db.Text
  submittedBy           String   @map("submitted_by") @db.Uuid
  submittedAt           DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  verification DestinationVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_evidence_verification")
  submitter    Account                 @relation(fields: [submittedBy], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_evidence_submitter")
  records      VerificationRecord[]

  @@index([verificationId], name: "idx_evidence_verification_id")
  @@index([evidenceType], name: "idx_evidence_type")
  @@map("verification_evidence")
}

model VerificationRecord {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  verificationId            String    @map("verification_id") @db.Uuid
  destinationId             String    @map("destination_id") @db.Uuid
  field                     String    @db.VarChar(50)
  status                    String    @default("unverified") @db.VarChar(32)
  verifiedBy                String    @map("verified_by") @db.Uuid
  evidenceId                String?   @map("evidence_id") @db.Uuid
  verifiedValueSnapshotHash String?   @map("verified_value_snapshot_hash") @db.VarChar(64)
  confidenceLevel           String    @map("confidence_level") @db.VarChar(50)
  notes                     String?   @db.Text
  timestamp                 DateTime  @default(now()) @db.Timestamptz(6)
  validUntil                DateTime? @map("valid_until") @db.Timestamptz(6)

  verification DestinationVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_records_verification")
  destination  Destination             @relation(fields: [destinationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_records_destination")
  verifier     Account                 @relation(fields: [verifiedBy], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_records_verifier")
  evidence     VerificationEvidence?   @relation(fields: [evidenceId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_records_evidence")

  @@index([destinationId, field], name: "idx_records_dest_field")
  @@index([verificationId], name: "idx_records_verification_id")
  @@index([timestamp(sort: Desc)], name: "idx_records_timestamp")
  @@map("verification_records")
}

// ------------------------------------------------------------------------------
// 5. User Bookmarks / Saved Destinations
// ------------------------------------------------------------------------------

model SavedDestination {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  destinationId  String   @map("destination_id") @db.Uuid
  collectionName String?  @map("collection_name") @db.VarChar(100)
  personalNotes  String?  @map("personal_notes") @db.Text
  savedAt        DateTime @default(now()) @map("saved_at") @db.Timestamptz(6)

  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_saved_account")
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_saved_destination")

  @@unique([accountId, destinationId], map: "uq_saved_destinations_account_dest")
  @@index([accountId], name: "idx_saved_account_id")
  @@index([destinationId], name: "idx_saved_destination_id")
  @@map("saved_destinations")
}

// ------------------------------------------------------------------------------
// 6. Audit Logging & Telemetry Privacy Architecture
// ------------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorAccountId String   @map("actor_account_id") @db.Uuid
  actorRole      String   @map("actor_role") @db.VarChar(32)
  action         String   @db.VarChar(64)
  entityType     String   @map("entity_type") @db.VarChar(64)
  entityId       String   @map("entity_id") @db.VarChar(64)
  timestamp      DateTime @default(now()) @db.Timestamptz(6)

  actor     Account            @relation(fields: [actorAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_audit_actor")
  telemetry AuditLogTelemetry?

  @@index([actorAccountId], name: "idx_audit_actor")
  @@index([entityType, entityId], name: "idx_audit_entity")
  @@index([timestamp(sort: Desc)], name: "idx_audit_timestamp")
  @@index([action], name: "idx_audit_action")
  @@map("audit_logs")
}

model AuditLogTelemetry {
  auditLogId            String                  @id @map("audit_log_id") @db.Uuid
  actorEmail            String?                 @map("actor_email") @db.VarChar(255)
  ipAddress             Unsupported("inet")?    @map("ip_address")
  userAgent             String?                 @map("user_agent") @db.Text
  previousStateSnapshot Json?     @map("previous_state_snapshot") @db.JsonB
  newStateSnapshot      Json?     @map("new_state_snapshot") @db.JsonB
  contextNotes          String?   @map("context_notes") @db.Text
  retentionExpiresAt    DateTime  @map("retention_expires_at") @db.Timestamptz(6)
  isAnonymized          Boolean   @default(false) @map("is_anonymized")
  anonymizedAt          DateTime? @map("anonymized_at") @db.Timestamptz(6)

  auditLog AuditLog @relation(fields: [auditLogId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_telemetry_audit")

  @@map("audit_log_telemetry")
}
